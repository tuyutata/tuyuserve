[Unit]
Description=TuyuServe PostgreSQL
After=local-fs.target
Before=tuyuserve.service

[Service]
Type=simple
User=tuyuserve-db
Group=tuyuserve
RuntimeDirectory=tuyuserve-postgresql
RuntimeDirectoryMode=0750
Environment=LD_LIBRARY_PATH=/opt/tuyuserve/postgresql/lib
ExecStart=/opt/tuyuserve/postgresql/bin/postgres -D /var/lib/tuyuserve/postgresql -c listen_addresses= -c unix_socket_directories=/run/tuyuserve-postgresql -c unix_socket_permissions=0770 -c password_encryption=scram-sha-256
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
UMask=0027
ReadWritePaths=/var/lib/tuyuserve/postgresql /run/tuyuserve-postgresql

[Install]
WantedBy=multi-user.target
