[Unit]
Description=TuyuServe
Requires=tuyuserve-postgresql.service
After=network-online.target tuyuserve-postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=tuyuserve
Group=tuyuserve
Environment=TUYUSERVE_HOME=/opt/tuyuserve
Environment=TUYUSERVE_DATA=/var/lib/tuyuserve
Environment=TUYUSERVE_POSTGRES_HOST=/run/tuyuserve-postgresql
Environment=TUYUSERVE_POSTGRES_PORT=5432
Environment=TUYUSERVE_POSTGRES_DATABASE=tuyuserve
Environment=TUYUSERVE_POSTGRES_USER=tuyuserve_app
Environment=LD_LIBRARY_PATH=/opt/tuyuserve/postgresql/lib
EnvironmentFile=/etc/tuyuserve/env
ExecStart=/opt/tuyuserve/node/bin/node /opt/tuyuserve/lib/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0027
ReadWritePaths=/var/lib/tuyuserve

[Install]
WantedBy=multi-user.target
