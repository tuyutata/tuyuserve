{
  "schema": 1,
  "repository": "tuyuserve",
  "workflows": [
    "tuyuserve.cloudflare.ci",
    "tuyuserve.cloudflare.release",
    "tuyuserve.linux-arm.ci",
    "tuyuserve.linux-arm.release"
  ],
  "node_tests": [
    "linux/import.test.mjs",
    "linux/storage.test.mjs",
    "scripts/build-local.test.mjs",
    "scripts/build.test.mjs",
    "scripts/ci/cloudflare/cloudflare/test.mjs",
    "scripts/ci/linux-arm/linux-arm64/test.mjs",
    "scripts/flow.test.mjs",
    "scripts/release/cloudflare/cloudflare/test.mjs",
    "scripts/release/linux-arm/linux-arm64/test.mjs",
    "scripts/resources.test.mjs",
    "scripts/target.test.mjs"
  ],
  "checks": [
    "repository-contracts"
  ],
  "tools": {
    "node": "25.2.1",
    "actionlint": "1.7.12",
    "rust": null
  },
  "platform_forbidden_values": [
    "macOS ARM64",
    "macos-arm64",
    "macos_arm64"
  ],
  "github_repository": "tuyutata/tuyuserve",
  "functions": [
    {
      "function": "account/tests/protocol",
      "path": "account/tests/protocol.rs",
      "runner": "cargo",
      "target": "account/Cargo.toml",
      "package": "tuyu-account",
      "cases": [
        "account_qr_only_accepts_canonical_tuyu_v1",
        "login_qr_and_digest_match_the_frozen_tuyu_v1_vector",
        "every_authorization_scope_field_is_bound_to_the_tuyu_v1_digest"
      ]
    },
    {
      "function": "account/tests/protocol_spec",
      "path": "account/tests/protocol_spec.rs",
      "runner": "cargo",
      "target": "account/Cargo.toml",
      "package": "tuyu-account",
      "cases": [
        "tuyu_v1_fixture_freezes_the_account_signature_contract"
      ]
    },
    {
      "function": "account/tests/session",
      "path": "account/tests/session.rs",
      "runner": "cargo",
      "target": "account/Cargo.toml",
      "package": "tuyu-account",
      "cases": [
        "local_session_keeps_product_and_installation_scope",
        "logout_removes_only_the_local_session"
      ]
    },
    {
      "function": "linux/import.test",
      "path": "linux/import.test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
