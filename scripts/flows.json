            "version": "2.54.0"
          },
          {
            "id": "node",
            "version": "25.2.1"
          }
        ],
        "version_source": {
          "kind": "json",
          "path": "package.json"
        },
        "record_source": {
          "kind": "manifest",
          "asset_names": [],
          "metadata_asset": "release-manifest.json",
          "source_field": "git_commit_sha",
          "version_field": "software_version",
