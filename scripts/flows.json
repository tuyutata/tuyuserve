          "id": "grep",
          "version": "3.12"
        },
        {
          "id": "sed",
          "version": "4.10"
        }
      ],
      "locks": [
        {
          "ecosystem": "npm",
          "path": "package-lock.json"
        }
      ],
      "ci": {
        "entry": ".github/workflows/tuyuserve-cloudflare-ci.yml",
        "tools": [
          {
            "id": "git",
            "version": "2.54.0"
